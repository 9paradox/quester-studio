{
	"version": "v1",
	"id": "showcase-pick-user",
	"name": "Showcase — pick user",
	"description": "Dynamic select via optionsFrom; bind users from the flow node.",
	"inputs": [
		{ "id": "users", "label": "Users", "type": "json", "required": true }
	],
	"fields": [
		{
			"id": "userId",
			"type": "select",
			"label": "Teammate",
			"required": true,
			"optionsFrom": {
				"items": "{{form.users}}",
				"value": "id",
				"label": "username"
			}
		}
	]
}
