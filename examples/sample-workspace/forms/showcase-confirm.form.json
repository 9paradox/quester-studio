{
	"version": "v1",
	"id": "showcase-confirm",
	"name": "Showcase — confirm",
	"description": "Readonly summary from prior forms + confirm boolean. Uses form inputs so each flow can bind its own node ids.",
	"inputs": [
		{ "id": "actor", "label": "Acting as", "type": "string", "required": true },
		{ "id": "theme", "label": "Theme", "type": "string", "required": true },
		{
			"id": "assigneeId",
			"label": "Assignee id",
			"type": "number",
			"required": true
		}
	],
	"fields": [
		{
			"id": "actor",
			"type": "string",
			"label": "Acting as",
			"readonly": true,
			"default": "{{form.actor}}"
		},
		{
			"id": "theme",
			"type": "string",
			"label": "Chosen theme",
			"readonly": true,
			"default": "{{form.theme}}"
		},
		{
			"id": "assigneeId",
			"type": "number",
			"label": "Assignee id",
			"readonly": true,
			"default": "{{form.assigneeId}}"
		},
		{
			"id": "notifyInDays",
			"type": "number",
			"label": "Remind in (days)",
			"required": true,
			"default": 3
		},
		{
			"id": "confirmed",
			"type": "boolean",
			"label": "Confirm handoff",
			"required": true,
			"default": false
		}
	]
}
