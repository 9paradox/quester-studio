{
	"version": "v1",
	"id": "pick-product",
	"name": "Pick product",
	"description": "Choose one product from the search results.",
	"inputs": [
		{
			"id": "products",
			"label": "Products",
			"type": "json",
			"required": true
		}
	],
	"fields": [
		{
			"id": "productId",
			"label": "Product",
			"required": true,
			"type": "select",
			"optionsFrom": {
				"items": "{{form.products}}",
				"value": "id",
				"label": "{{title}} · {{brand}} · ${{price}}"
			}
		}
	]
}
