{
	"id": "nested-frames",
	"version": "v1",
	"name": "Nested frames",
	"description": "foreach → try → template: nested framed containers with entry/in and success/exit wiring.",
	"nodes": [
		{
			"id": "start",
			"type": "start",
			"data": { "label": "Start" },
			"position": { "x": 0, "y": 120 },
			"width": 180,
			"height": 72
		},
		{
			"id": "in",
			"type": "input",
			"data": {
				"value": { "ids": ["a", "b", "c"] },
				"label": "Input ids"
			},
			"position": { "x": 220, "y": 120 },
			"width": 180,
			"height": 72
		},
		{
			"id": "loop",
			"type": "foreach",
			"data": {
				"items": "ids",
				"maxItems": 100,
				"label": "Map ids"
			},
			"position": { "x": 460, "y": 40 },
			"width": 420,
			"height": 300
		},
		{
			"id": "guard",
			"type": "try",
			"parentId": "loop",
			"extent": "parent",
			"data": { "label": "Per-item try" },
			"position": { "x": 40, "y": 48 },
			"width": 320,
			"height": 220
		},
		{
			"id": "row",
			"type": "template",
			"parentId": "guard",
			"extent": "parent",
			"data": {
				"template": "{{item}}-ok",
				"mode": "safe",
				"label": "Row"
			},
			"position": { "x": 40, "y": 56 },
			"width": 200,
			"height": 72
		},
		{
			"id": "out",
			"type": "output",
			"data": { "label": "Results" },
			"position": { "x": 940, "y": 120 },
			"width": 180,
			"height": 72
		}
	],
	"edges": [
		{
			"id": "e-start-in",
			"source": "start",
			"target": "in"
		},
		{
			"id": "e-in-loop",
			"source": "in",
			"target": "loop"
		},
		{
			"id": "e-loop-entry",
			"source": "loop",
			"target": "guard",
			"sourceHandle": "entry",
			"targetHandle": "in"
		},
		{
			"id": "e-guard-exit-loop",
			"source": "guard",
			"target": "loop",
			"sourceHandle": "success",
			"targetHandle": "exit"
		},
		{
			"id": "e-guard-entry",
			"source": "guard",
			"target": "row",
			"sourceHandle": "entry"
		},
		{
			"id": "e-row-exit-guard",
			"source": "row",
			"target": "guard",
			"targetHandle": "exit"
		},
		{
			"id": "e-loop-complete",
			"source": "loop",
			"target": "out",
			"sourceHandle": "complete"
		}
	]
}
