{
	"id": "login-and-profile",
	"version": "v1",
	"name": "Login and profile",
	"description": "Hero scenario: POST login → extract access token → GET /auth/me with Bearer auth → assert status (DummyJSON). Readable path for developers, testers, and business analysts. Includes a disconnected note sticky.",
	"nodes": [
		{
			"id": "start",
			"type": "start",
			"data": {
				"label": "Start"
			},
			"position": {
				"x": -264,
				"y": 8
			},
			"width": 210,
			"height": 87
		},
		{
			"id": "input",
			"type": "input",
			"data": {
				"value": {
					"username": "emilys",
					"password": "emilyspass"
				},
				"label": "Credentials"
			},
			"position": {
				"x": -7,
				"y": 12
			},
			"width": 150,
			"height": 87
		},
		{
			"id": "login",
			"type": "http",
			"data": {
				"method": "POST",
				"url": "{{env.API_BASE}}/auth/login",
				"headers": {
					"Content-Type": "application/json"
				},
				"body": "{\n  \"username\": \"{{secrets.username}}\",\n  \"password\": \"{{secrets.password}}\"\n}",
				"label": "Login"
			},
			"position": {
				"x": 0,
				"y": 199.04515841965383
			},
			"width": 210,
			"height": 87
		},
		{
			"id": "accessToken",
			"type": "extract",
			"data": {
				"expression": "body.accessToken",
				"label": "Access token"
			},
			"position": {
				"x": 320.1294494551188,
				"y": 227
			},
			"width": 210,
			"height": 53
		},
		{
			"id": "profile",
			"type": "http",
			"data": {
				"method": "GET",
				"url": "{{env.API_BASE}}/auth/me",
				"headers": {
					"Authorization": "Bearer {{nodes.accessToken}}"
				},
				"label": "Profile"
			},
			"position": {
				"x": -4.047294093282517,
				"y": 369
			},
			"width": 210,
			"height": 87
		},
		{
			"id": "assertStatus",
			"type": "assert",
			"data": {
				"checks": [
					{
						"path": "status",
						"equals": 200
					}
				],
				"label": "Assert 200"
			},
			"position": {
				"x": 290.28059298166613,
				"y": 535.5109416723401
			},
			"width": 210,
			"height": 87
		},
		{
			"id": "extractAge",
			"type": "extract",
			"data": {
				"expression": "body.bank.currency",
				"label": "Extract currency"
			},
			"position": {
				"x": 311.30874971229,
				"y": 372.4525274389194
			},
			"width": 214,
			"height": 53
		},
		{
			"id": "output",
			"type": "output",
			"data": {
				"label": "Result"
			},
			"position": {
				"x": 312.8593583938059,
				"y": 449.1696533118233
			},
			"width": 150,
			"height": 53
		},
		{
			"id": "http-6d0ea217",
			"type": "http",
			"data": {
				"method": "POST",
				"url": "{{env.API_BASE}}/posts/add",
				"headers": {
					"Content-type": "application/json"
				},
				"body": "{\n  \"title\": \"lol {{nodes.profile.body.address.city}}\",\n  \"userId\": {{nodes.profile.body.id}}\n}",
				"label": "Add post"
			},
			"position": {
				"x": 237.21789670230652,
