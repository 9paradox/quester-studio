{
	"name": "@quester-studio/desktop",
	"version": "0.6.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node scripts/patch-electrobun-win.mjs && vite build && electrobun dev",
		"dev:hmr": "node scripts/patch-electrobun-win.mjs && node scripts/dev-hmr.mjs",
		"dev:stop": "node scripts/stop-dev.mjs",
		"dev:debug": "node scripts/patch-electrobun-win.mjs && node scripts/dev-debug.mjs",
		"dev:hmr:debug": "node scripts/patch-electrobun-win.mjs && node scripts/dev-debug.mjs --hmr",
		"dev:web": "vite --config vite.config.web.ts --open",
		"dev:web:mock": "vite --config vite.config.web.ts --open --mode mock",
		"build": "vite build",
		"build:web": "vite build --config vite.config.web.ts",
		"build:app": "node scripts/patch-electrobun-win.mjs && node scripts/sync-sample-workspace.mjs && vite build && electrobun build --env=stable && node scripts/package-windows.mjs",
		"build:app:mac": "node scripts/sync-sample-workspace.mjs && vite build && electrobun build --env=stable",
		"package:windows": "node scripts/package-windows.mjs",
		"typecheck": "tsc --noEmit",
		"test": "bun test src",
		"test:smoke": "bun test src/renderer/components/AppShell.smoke.test.tsx",
		"lint": "biome check src"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/lang-html": "^6.4.11",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-xml": "^6.1.0",
		"@codemirror/language": "^6.12.4",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/state": "^6.7.1",
		"@codemirror/view": "^6.43.6",
		"@fontsource-variable/geist": "^5.2.9",
		"@lezer/highlight": "^1.2.3",
		"@quester-studio/api-contract": "workspace:*",
		"@quester-studio/engine": "workspace:*",
		"@quester-studio/schema": "workspace:*",
		"@quester-studio/workspace-service": "workspace:*",
		"@reactflow/node-resizer": "2.2.14",
		"@tabler/icons-react": "^3.44.0",
		"@uiw/react-codemirror": "^4.25.11",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"electrobun": "^1.18.1",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-json-view-lite": "^2.5.0",
		"reactflow": "^11.11.4",
		"shadcn": "^4.13.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "^20.11.1",
		"@quester-studio/tsconfig": "workspace:*",
		"@tailwindcss/vite": "^4",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^22.15.3",
		"@types/react": "^19.1.2",
		"@types/react-dom": "^19.1.2",
		"@types/three": "^0.165.0",
		"@vitejs/plugin-react": "^4.4.1",
		"concurrently": "^9.2.1",
		"happy-dom": "^20.11.1",
		"lightningcss": "^1.32.0",
		"tailwindcss": "^4",
		"typescript": "^5.8.3",
		"vite": "6.4.3"
	}
}
