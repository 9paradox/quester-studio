			},
			{
				href: href("docs/nodes/foreach/"),
				label: "foreach",
				on: active("/docs/nodes/foreach"),
			},
			{
				href: href("docs/nodes/try/"),
				label: "try",
				on: active("/docs/nodes/try"),
			},
			{
