---
const base = import.meta.env.BASE_URL;
---

<footer class="border-t border-border bg-sidebar">
	<div
		class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-8 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between sm:px-6"
	>
		<p>
			Scenario API testing for developers, testers, and business analysts. Secrets stay on your
			machine.
		</p>
		<div class="flex flex-wrap gap-4">
			<a class="hover:text-foreground" href={`${base}download/`}>Download</a>
			<a class="hover:text-foreground" href={`${base}docs/`}>Docs</a>
			<a class="hover:text-foreground" href={`${base}docs/getting-started/`}>CLI</a>
			<a
				class="hover:text-foreground"
				href="https://github.com/9paradox/quester-studio"
				>GitHub</a
			>
		</div>
	</div>
</footer>
