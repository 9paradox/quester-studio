---
const steps = [
	{
		title: "Drag-and-drop nodes",
		body: "Drop a node on the canvas — form, HTTP, extract, and the rest live in the same graph.",
	},
	{
		title: "HTTP request",
		body: "GET or POST with env and previous-step values in the URL and body.",
	},
	{
		title: "Mid-flow form",
		body: "A form can sit between requests. The run waits until you submit.",
	},
	{
		title: "Bind the next call",
		body: "Select options can come from the last response, then the next request runs.",
	},
];
