---
const steps = [
	{
		title: "Open workspace",
		body: "Open a folder with quester.json — or jump in with the sample workspace.",
	},
	{
		title: "Build the flow",
		body: "Drop nodes on the canvas and connect them: start → input → http → extract → output.",
	},
	{
		title: "Run locally",
		body: "Choose an environment and press Run. Everything executes on your machine.",
	},
	{
		title: "Inspect results",
		body: "Check status, response body, and extracts in the inspector — data stays local.",
	},
];
---

<section class="demo" data-how-it-works aria-label="Quester Studio interactive preview">
	<div class="demo__shell" aria-hidden="true">
		<header class="demo__topbar">
			<div class="demo__tabs">
				<div class="demo__tab is-active">
					<svg
						class="demo__ico"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
						><circle cx="6" cy="6" r="2"></circle><circle cx="18" cy="18" r="2"></circle><path
							d="M8 6h8a2 2 0 0 1 2 2v8"></path
						><path d="M6 8v8a2 2 0 0 0 2 2h8"></path></svg
					>
					<span>demo-main-nodes</span>
				</div>
				<div class="demo__tab">login-and-profile</div>
			</div>
			<div class="demo__win">
				<span class="demo__win-btn" title="Minimize">
					<svg viewBox="0 0 12 12" aria-hidden="true"
						><path fill="currentColor" d="M2 6.25h8v1.1H2z"></path></svg
					>
				</span>
				<span class="demo__win-btn" title="Maximize">
					<svg viewBox="0 0 12 12" aria-hidden="true"
						><rect
							x="2.4"
							y="2.4"
							width="7.2"
							height="7.2"
							fill="none"
							stroke="currentColor"
							stroke-width="1.15"></rect
					></svg>
				</span>
				<span class="demo__win-btn demo__win-btn--close" title="Close">
					<svg viewBox="0 0 12 12" aria-hidden="true"
						><path
							fill="none"
							stroke="currentColor"
							stroke-width="1.15"
							d="M3 3l6 6M9 3l-6 6"></path
					></svg>
				</span>
			</div>
		</header>

		<div class="demo__main">
			<nav class="demo__activity">
				<span class="demo__act is-active" title="Flows">
					<svg
						class="demo__ico"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						><path d="M14 3v4a1 1 0 0 0 1 1h4"></path><path
							d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z"
						></path><path d="M9 13h6"></path><path d="M9 17h6"></path></svg
					>
				</span>
				<span class="demo__act" title="Collections">
					<svg
						class="demo__ico"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						><path d="M5 4h4l3 3h7a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2"
						></path></svg
					>
				</span>
				<span class="demo__act" title="Environments">
					<svg
						class="demo__ico"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						><path d="M12 4 4 8l8 4 8-4-8-4"></path><path d="m4 12 8 4 8-4"></path><path
							d="m4 16 8 4 8-4"></path
						></svg>
				</span>
				<span class="demo__act demo__act--bottom" title="Preferences">
					<svg
						class="demo__ico"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6"></path><path
							d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 0 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 0 1-4 0v-.1a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 0 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 0 1 0-4h.1a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 0 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 0 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 0 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9c.3.6.9 1 1.5 1H21a2 2 0 0 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"
						></path></svg
