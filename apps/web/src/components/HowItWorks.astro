<script>
	const root = document.querySelector("[data-how-it-works]");
	if (root instanceof HTMLElement) {
		const captions = [
			"Drop a node on the canvas — form, HTTP, extract, and the rest live in the same graph.",
			"GET or POST with env and previous-step values in the URL and body.",
			"A form can sit between requests. The run waits until you submit.",
			"Select options can come from the last response, then the next request runs.",
		];
		const visualFor = [0, 1, 2, 3];
		const statusByVisual = ["Ready", "Running…", "Running… awaiting form", "Succeeded"];
		const count = captions.length;
		const captionEl = root.querySelector("[data-how-caption]");
		const statusLabel = root.querySelector("[data-status-label]");
		const buttons = [...root.querySelectorAll("[data-step]")];
		const arrows = [...root.querySelectorAll("[data-arrow]")];
		const fill = root.querySelector("[data-progress-fill]");
		const cycleMs = 20000;
		let index = -1;
		let elapsed = 0;
		let lastTs = 0;
		let raf = 0;
		let visible = true;

		function setStep(next) {
			const step = ((next % count) + count) % count;
			if (step === index) return;
			index = step;
			const visual = visualFor[index] ?? 0;
			root.dataset.visual = String(visual);
			if (visual === 0) {
				for (const el of root.querySelectorAll(".fn, .demo__edge")) {
					if (!(el instanceof HTMLElement)) continue;
					el.style.animation = "none";
					void el.offsetWidth;
					el.style.animation = "";
				}
			}
			if (visual >= 1) {
				for (const el of root.querySelectorAll(
					".demo__url-type, .demo__fill, .demo__json, .demo__sheet, .demo__form-layer, .demo__field, .demo__sheet-foot",
				)) {
					if (!(el instanceof HTMLElement)) continue;
					el.style.animation = "none";
					void el.offsetWidth;
					el.style.animation = "";
				}
			}
			if (captionEl) captionEl.textContent = captions[index] ?? "";
			if (statusLabel) statusLabel.textContent = statusByVisual[visual] ?? "Ready";
			const auxTitle = root.querySelector("[data-aux-title]");
			if (auxTitle) {
				auxTitle.textContent = visual === 3 ? "Response" : "Inspector";
			}
			for (const btn of buttons) {
				const i = Number(btn.getAttribute("data-step"));
				btn.setAttribute("aria-selected", i === index ? "true" : "false");
				btn.classList.toggle("is-done", i < index);
				const mark = btn.querySelector(".demo__step-index");
				if (mark) mark.textContent = i < index ? "" : String(i + 1);
			}
			for (const arrow of arrows) {
				const i = Number(arrow.getAttribute("data-arrow"));
				arrow.classList.toggle("is-on", i < index);
			}
		}

		function tick(ts) {
			if (!visible) {
				raf = 0;
				return;
			}
			if (lastTs) elapsed += ts - lastTs;
			lastTs = ts;
			if (elapsed >= cycleMs) elapsed %= cycleMs;
			const p = elapsed / cycleMs;
			if (fill instanceof HTMLElement) fill.style.width = `${p * 100}%`;
			setStep(Math.min(count - 1, Math.floor(p * count)));
			raf = window.requestAnimationFrame(tick);
		}

		function start() {
			if (raf) return;
			lastTs = 0;
			raf = window.requestAnimationFrame(tick);
		}

		function stop() {
			if (raf) window.cancelAnimationFrame(raf);
			raf = 0;
			lastTs = 0;
		}

		for (const btn of buttons) {
			btn.addEventListener("click", () => {
				const i = Number(btn.getAttribute("data-step"));
				elapsed = (i / count) * cycleMs;
				setStep(i);
			});
		}

		if ("IntersectionObserver" in window) {
			const io = new IntersectionObserver(
				([entry]) => {
					visible = Boolean(entry?.isIntersecting);
					if (visible) start();
					else stop();
				},
				{ threshold: 0.12 },
			);
			io.observe(root);
		}

		setStep(0);
		start();
	}
</script>

<style>
	.demo {
		display: grid;
		gap: 1.25rem;
		width: 100%;
	}

	.demo__scroll {
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
	}

	.demo__shell {
		position: relative;
		min-width: 72rem;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: calc(var(--radius) * 1.2);
		background: var(--background);
		box-shadow: 0 28px 56px -32px color-mix(in oklch, var(--foreground) 30%, transparent);
		font-size: 12px;
	}

	.demo__topbar {
		display: flex;
		align-items: stretch;
		min-height: 2.25rem;
		border-bottom: 1px solid var(--border);
	}

	.demo__ws {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		max-width: 14rem;
		flex-shrink: 0;
		border-right: 1px solid var(--border);
		padding: 0 0.75rem;
		color: var(--muted-foreground);
		font-size: 0.7rem;
		white-space: nowrap;
	}

	.demo__ico--tiny {
		width: 0.7rem;
		height: 0.7rem;
		opacity: 0.7;
	}

	.demo__tabs {
		display: flex;
		min-width: 0;
		flex: 1;
		overflow: hidden;
	}

	.demo__tab {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		border-right: 1px solid color-mix(in oklch, var(--border) 70%, transparent);
		padding: 0 0.35rem 0 0.7rem;
		color: var(--muted-foreground);
		font-size: 0.72rem;
		white-space: nowrap;
	}

	.demo__tab.is-active {
		background: var(--background);
		color: var(--foreground);
		font-weight: 600;
	}

	.demo__tab.is-active::after {
