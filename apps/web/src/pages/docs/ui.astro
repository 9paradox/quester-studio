---
import { existsSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import DocsLayout from "../../layouts/DocsLayout.astro";

const shots = [
	{
		id: "shell",
		file: "shell.png",
		title: "App shell",
		caption:
			"Quester Studio chrome with the sample workspace open and login-and-profile selected in the Flows sidebar.",
	},
	{
		id: "canvas",
		file: "canvas.png",
		title: "Flow canvas",
		caption:
			"login-and-profile graph: credentials → login → token extract → profile request, with assert on the profile step.",
	},
	{
		id: "inspector",
		file: "inspector.png",
		title: "Node inspector",
		caption:
			"Inspector open on the http (or extract) node of demo-main-nodes, showing method/URL or JMESPath fields.",
	},
	{
		id: "run-panel",
		file: "run-panel.png",
		title: "Run panel",
		caption:
			"After a successful run of demo-main-nodes — response / output visible in the run panel.",
	},
];

const shotsDir = join(
	dirname(fileURLToPath(import.meta.url)),
	"../../public/screenshots",
);
const base = import.meta.env.BASE_URL;
---

<DocsLayout
	title="UI reference"
	description="Quester Studio desktop UI reference — shell, canvas, inspector, and run panel."
>
	<article>
		<h1 class="text-3xl font-semibold tracking-tight">UI reference</h1>
		<p class="mt-3 text-muted-foreground">
			Desktop layout reference. Screenshots show the
			<code class="rounded bg-muted px-1">login-and-profile</code> flow from the sample workspace.
		</p>

		<div class="mt-10 space-y-12">
			{
				shots.map((shot) => {
					const hasFile = existsSync(join(shotsDir, shot.file));
					return (
						<section>
							<h2 class="text-lg font-semibold tracking-tight">{shot.title}</h2>
							<figure class="mt-3">
								{hasFile ? (
									<img
										src={`${base}screenshots/${shot.file}`}
										alt={shot.caption}
										class="h-auto w-full max-w-full rounded-xl border border-border"
										loading="lazy"
										decoding="async"
									/>
								) : (
									<div
										class="flex aspect-video items-center justify-center rounded-xl border border-dashed border-border bg-muted/60 px-6 text-center"
										data-shot={shot.id}
									>
										<div>
											<p class="text-sm font-medium text-foreground">
												Screenshot placeholder
											</p>
											<p class="mt-1 font-mono text-xs text-muted-foreground">
												{shot.file}
											</p>
										</div>
									</div>
								)}
								<figcaption class="mt-2 text-sm text-muted-foreground">
									{shot.caption}
								</figcaption>
							</figure>
						</section>
					);
				})
			}
		</div>

		<p class="mt-12 text-sm text-muted-foreground">
			Capture checklist:
			<code class="rounded bg-muted px-1">apps/web/public/screenshots/README.md</code>. CLI and
			node reference:
			<a
				class="underline underline-offset-2 hover:text-foreground"
				href={`${base}docs/getting-started/`}>Getting started</a
			>
			·
			<a class="underline underline-offset-2 hover:text-foreground" href={`${base}docs/nodes/`}
				>Nodes</a
			>.
		</p>
	</article>
</DocsLayout>
