---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const releases = "https://github.com/9paradox/quester-studio/releases";
const security =
	"https://github.com/9paradox/quester-studio/blob/main/SECURITY.md";
---

<BaseLayout
	title="Download"
	description="Download Quester Studio for Windows or Linux — unsigned public preview builds."
>
	<article class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
		<h1 class="text-3xl font-semibold tracking-tight">Download Quester Studio</h1>
		<p class="mt-3 text-muted-foreground">
			Public preview builds for Windows and Linux. macOS is not published yet.
		</p>

		<ol class="mt-8 list-decimal space-y-4 pl-5 text-sm leading-relaxed">
			<li>
				Open the latest
				<a class="font-medium text-foreground underline underline-offset-2" href={releases}
					>GitHub Release</a
				>
				(current
				<a
					class="underline underline-offset-2"
					href="https://github.com/9paradox/quester-studio/releases/tag/v0.4.5"
					>v0.4.5</a
				>).
			</li>
			<li>
				Download a desktop artifact:
				<ul class="mt-2 list-disc space-y-1 pl-5 text-muted-foreground">
					<li>
						<strong class="text-foreground">Windows:</strong>
						<code class="rounded bg-muted px-1">Quester-*-win-x64-setup.exe</code>
						(NSIS) or
						<code class="rounded bg-muted px-1">Quester-*-win-x64-portable.zip</code>
						— extract, run
						<code class="rounded bg-muted px-1">Quester\bin\launcher.exe</code>.
						Older builds used
						<code class="rounded bg-muted px-1">stable-win-x64-Quester-Setup.zip</code>.
					</li>
					<li>
						<strong class="text-foreground">Linux:</strong>
						<code class="rounded bg-muted px-1">stable-linux-x64-Quester-Setup.tar.gz</code>
						(or matching <code class="rounded bg-muted px-1">.tar.zst</code>).
					</li>
				</ul>
			</li>
			<li>
				Builds are <strong class="text-foreground">unsigned development builds</strong>. Prefer verifying
				published checksums when available. See
				<a class="underline underline-offset-2" href={security}>SECURITY.md</a>
				for the trust model.
			</li>
			<li>
				Launch Quester Studio → <strong class="text-foreground">Open sample</strong> → run
				<code class="rounded bg-muted px-1">demo-main-nodes</code> with env
				<code class="rounded bg-muted px-1">local</code>.
			</li>
		</ol>

		<div class="mt-10 flex flex-wrap gap-3">
			<a
				href={releases}
				class="inline-flex items-center justify-center rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground hover:opacity-90"
			>
				GitHub Releases
			</a>
			<a
				href={`${base}guide/`}
				class="inline-flex items-center justify-center rounded-lg border border-border px-4 py-2.5 text-sm font-semibold hover:bg-muted"
			>
				Getting started guide
			</a>
		</div>

		<p class="mt-10 text-sm text-muted-foreground">
			Prefer the command line?
			<a
				class="underline underline-offset-2 hover:text-foreground"
				href={`${base}docs/getting-started/`}
				>CLI getting started</a
			>.
		</p>
	</article>
</BaseLayout>
